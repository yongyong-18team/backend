# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.
# 로컬은 local, 서버는 dev
SPRING_PROFILES_ACTIVE=local

# 서버에서만 필요 (local은 application-local.yml 값을 씀). 서버: jdbc:postgresql://localhost:5432/batong
DB_URL=
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=
JWT_ACCESS_TTL=7d

AI_MODE=mock
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=15000
STT_PROVIDER= groq
STT_API_KEY=

DATA_GO_KR_API_KEY=
GG_DATA_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SHARE_BASE_URL=http://localhost:5173
ADMIN_API_KEY=
